    "def fakultaet(n):\n",
    "    ergebnis = 1\n",
    "    for i in range(2, n + 1):\n",
    "        ergebnis *= i\n",
    "    return ergebnis\n",
    "\n",
    "for zahl in range(1, 6):\n",
    "    print(f\"{zahl}! = {fakultaet(zahl)}\")"
   ]
